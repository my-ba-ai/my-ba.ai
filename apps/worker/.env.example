NODE_ENV=development
# Must point at the same Redis as apps/api, or the worker listens to queues
# nobody writes to.
REDIS_URL=redis://localhost:6379

# --- Database (P1-4) --------------------------------------------------------
# The screening processor reads tasks and writes analysis_steps, results and
# the HtAG ledger as the app role. Never the postgres superuser (RLS).
DATABASE_URL=postgresql://my_ba_app:app@localhost:5432/my_ba
DATABASE_POOL_MAX=5
# The orchestrator's own checkpointer pool (docs/02).
CHECKPOINTER_POOL_MAX=5

# --- HtAG (P1-1) ------------------------------------------------------------
# Server-side only (HtAG T&C cl. 36). Read by @my-ba/htag-client via
# htagClientConfigFromEnv(); first consumed by the screening worker (P1-4).
# Leave empty here; put the real key (`sk-org-…`) in apps/worker/.env, never in
# git — the `htag-api-key` gitleaks rule blocks it on commit.
HTAG_API_KEY=
# Optional. Defaults to https://api.htagai.com/v1; https://api.dev.htagai.com/v1 also exists.
HTAG_BASE_URL=

# --- Screener (P1-4) --------------------------------------------------------
# Defaults match the priced shape (AUD $26.30 first-run ceiling, Q22).
# SCREEN_QUERY_LIMIT=100
# SCREEN_RESTRICTED_TOP_N=6
# SCREEN_TREND_BATCH_SIZE=50
# Dev-only (Q04): restrict every screen to these states, e.g. NSW. Refused
# when NODE_ENV=production.
SCREEN_STATES_OVERRIDE=
