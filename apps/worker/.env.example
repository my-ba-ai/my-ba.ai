NODE_ENV=development
# Must point at the same Redis as apps/api, or the worker listens to queues
# nobody writes to.
REDIS_URL=redis://localhost:6379

# --- HtAG (P1-1) ------------------------------------------------------------
# Server-side only (HtAG T&C cl. 36). Read by @my-ba/htag-client via
# htagClientConfigFromEnv(); first consumed by the screening worker (P1-4).
# Leave empty here; put the real key (`sk-org-…`) in apps/worker/.env, never in
# git — the `htag-api-key` gitleaks rule blocks it on commit.
HTAG_API_KEY=
# Optional. Defaults to https://api.htagai.com/v1; https://api.dev.htagai.com/v1 also exists.
HTAG_BASE_URL=
