NODE_ENV=development
PORT=3001
# CORS origin for apps/web
WEB_ORIGIN=http://localhost:3000

# Application database connection. Deliberately NOT the postgres superuser:
# superusers bypass row-level security, which would make every tenant policy
# in the schema a no-op. GET /api/health/db reports whether the role in use
# actually has RLS enforced against it.
DATABASE_URL=postgresql://my_ba_app:app@localhost:5432/my_ba
DATABASE_POOL_MAX=10

# --- Clerk (P0-3) ---------------------------------------------------------
# Clerk owns credentials, sessions and MFA (D41). This app stores only a mirror
# row keyed by the Clerk user id, so the provider can be swapped without
# touching a foreign key.
#
# The API refuses to start without a usable verification key. That is
# deliberate: there is no flag that turns the guard off, because a flag that
# turns the guard off can be set in the wrong environment.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# PEM public key from the Clerk dashboard. Present = networkless verification,
# no JWKS fetch on the request path. Absent = JWKS lookup using the secret key.
CLERK_JWT_KEY=
# Origins permitted to have minted a token this API accepts. Without it, a token
# issued for another application on the same Clerk instance is honoured here.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# How long a resolved identity is cached (in Redis, shared by every API
# process) before it is looked up again.
AUTH_IDENTITY_CACHE_TTL_MS=60000

# --- Redis / BullMQ (P0-4) ------------------------------------------------
# Required. Holds the BullMQ queues and the identity cache. Anyone who can
# write to this Redis can point a Clerk id at another tenant via the cache, so
# outside local dev it must require auth (rediss://user:pass@host).
REDIS_URL=redis://localhost:6379

# Bull Board at /api/admin/queues, behind HTTP basic auth. Mounted only when
# both are set, and never when NODE_ENV=production — it is a dev tool until it
# is gated on a Clerk admin role. Password must be at least 12 characters.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
