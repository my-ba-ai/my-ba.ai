{
  "name": "my-ba-ai",
  "version": "0.0.0",
  "private": true,
  "description": "my-ba.ai — AU investment property suburb-selection and agent-outreach SaaS",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:bootstrap": "pnpm --filter @my-ba/db run bootstrap",
    "db:generate": "pnpm --filter @my-ba/db run generate",
    "db:migrate": "pnpm --filter @my-ba/db run migrate",
    "db:studio": "pnpm --filter @my-ba/db run studio",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
