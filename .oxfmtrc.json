{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "lineWidth": 100,
  "indentWidth": 2,
  "semicolons": true,
  "quoteStyle": "single",
  "trailingCommas": "all",
  "ignore": [
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/node_modules/**",
    "docs/prototypes/**",
    "pnpm-lock.yaml"
  ]
}
