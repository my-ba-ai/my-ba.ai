# Application connection. Non-superuser on purpose: RLS is bypassed by
# superusers, so connecting as `postgres` would make every policy a no-op.
DATABASE_URL=postgresql://my_ba_app:app@localhost:5432/my_ba

# Migration connection. Schema owner. Used only by `pnpm db:migrate` and
# `drizzle-kit studio`, never by apps/api or apps/worker.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/my_ba
