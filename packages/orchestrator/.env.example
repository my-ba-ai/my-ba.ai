# Application connection. The checkpointer runs as my_ba_app, the same
# NOSUPERUSER/NOBYPASSRLS role as the API and worker (D51).
DATABASE_URL=postgresql://my_ba_app:app@localhost:5432/my_ba

# Schema owner. Only `pnpm db:migrate` (-> checkpointer:setup) uses this.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/my_ba

# Dedicated pool for the checkpointer (docs/02 risk: checkpointer connection
# exhaustion). Kept separate from DATABASE_POOL_MAX on purpose.
CHECKPOINTER_POOL_MAX=5
