{
  "extends": "@my-ba/config/tsconfig.lib.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // The @langchain packages only describe their entry points through
    // package.json "exports". tsconfig.lib's node10 resolution ignores`
    // "exports", so this package opts into Node16 (still emits CommonJS,
    // because there is no "type": "module" here).
    "module": "Node16",
    "moduleResolution": "Node16"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
